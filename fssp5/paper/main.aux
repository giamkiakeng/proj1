\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Anatomy of the line of length $n=12$ (time runs downwards, one square per cell and time step; the colours show regions, not states). Above the two input anti-diagonals the line coincides with the half-line (\cref  {lem:agree}); the reflected triangle $R_n$ below them is computed from these two anti-diagonals alone (\cref  {lem:determinacy}), in the relative coordinates $\tau $ and $\kappa $ measured from the right end. The firing of the right end ($\bigstar $) depends only on the dark input cells, its cone (\cref  {lem:cone}), which ends where the dotted line $i=t/3$ crosses the input anti-diagonals (\cref  {thm:third}).}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:anatomy}{{5}{13}{Anatomy of the line of length $n=12$ (time runs downwards, one square per cell and time step; the colours show regions, not states). Above the two input anti-diagonals the line coincides with the half-line (\cref {lem:agree}); the reflected triangle $R_n$ below them is computed from these two anti-diagonals alone (\cref {lem:determinacy}), in the relative coordinates $\tau $ and $\kappa $ measured from the right end. The firing of the right end ($\bigstar $) depends only on the dark input cells, its cone (\cref {lem:cone}), which ends where the dotted line $i=t/3$ crosses the input anti-diagonals (\cref {thm:third})}{figure.5}{}}
